APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# Redis, not the database. The store holds the API payload caches, the A2S
# challenge cache, and — the reason it matters operationally — every uniqueness
# lock a queued QueryServer holds and every withoutOverlapping mutex the
# scheduler holds. On the database store all of that is round trips to the same
# Postgres the monitor is already saturating, and Cache::tags() is not supported
# at all, so a cached listing has nothing to invalidate it.
CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Both indices are set explicitly, and both differ from Laravel's defaults of 0
# and 1 on purpose: `cache:clear` is FLUSHDB, which empties the whole index and
# not just our keys. CACHE_PREFIX does not protect anything from it. On a box
# where Redis is shared with another application, the default lands us on top of
# it — check `redis-cli info keyspace` before picking, and give this app an
# index nothing else is using.
REDIS_DB=3
REDIS_CACHE_DB=4

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Where the /contact form's messages land. Falls back to MAIL_FROM_ADDRESS if
# unset, which reaches someone on the same deployment but is rarely the mailbox
# a real operator watches.
CONTACT_TO=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Telling the frontend that a page it has cached is out of date — the catalog
# growing, a server being published. Without both of these, revalidation is
# skipped and freshness falls back to the cache windows in web/lib/data.ts,
# which are minutes rather than immediate.
# The secret must match REVALIDATE_SECRET in the frontend's environment.
FRONTEND_REVALIDATE_URL=http://localhost:3000/api/revalidate
FRONTEND_REVALIDATE_SECRET=

# Absolute base for game artwork URLs. Set this whenever the frontend reads this
# API over loopback (API_URL_INTERNAL in web/.env.local) — otherwise asset()
# answers relative to the address the request arrived on, and covers come back
# pointing at 127.0.0.1.
ASSET_URL=https://api.lobbyhub.gg

# Steam Web API key. Used for reading the server lists most of the monitoring
# now runs on, and for "Sign in with Steam": the OpenID handshake needs no
# secret, but the persona name does.
#
# More than one key goes here comma-separated, and requests are dealt round
# robin across them. A key is rated per day and the sweeps cost roughly 42 000
# calls against 100 000, so one is enough today; a second is the way to buy
# room without changing anything else.
# https://steamcommunity.com/dev/apikey
STEAM_API_KEY=

# Whether a Steam sweep may add a server the catalog has not seen before.
# Off by default: the sweep still refreshes what is already listed, but new
# rows land only through the submission form or the admin import. Turn on
# to bring back automatic discovery of every Source server Steam knows.
# MONITORING_STEAM_CREATE_NEW_SERVERS=false

# Whether the scheduler fires steam:sync every 5/30 minutes. Off freezes the
# refresh path — the sweep only runs when called by hand. Combined with the
# discovery flag above and the polling flag below, off/off/off is the full
# freeze mode: the catalog changes only when a person does something.
# MONITORING_SWEEP_ENABLED=false

# Whether the scheduler fires servers:query every minute. Off, the UDP
# polling queue stops receiving new work; the on-demand refresh button on
# each server page still runs inline.
# MONITORING_POLLING_ENABLED=false

# Sign-in providers. A provider without credentials is not offered at all —
# the dialog asks the API which buttons to draw. Register the redirect URI as
# {APP_URL}/api/auth/{provider}/callback in each console.
# https://discord.com/developers/applications → OAuth2
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# https://console.cloud.google.com/apis/credentials → OAuth client ID
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email sign-in codes. Defaults: 10 minutes, 5 guesses, 60 seconds between sends.
# AUTH_CODE_TTL=600
# AUTH_CODE_ATTEMPTS=5
# AUTH_CODE_COOLDOWN=60
# AUTH_TOKEN_LIFETIME_DAYS=30

# ClickHouse — the player-count history behind every server's chart, and where
# a manual refresh writes the sample it just measured. The Go sweeper dials the
# native protocol on CH_PORT; PHP reads and writes over HTTP, hence the second
# port. Empty CH_HOST is a valid mode: the chart reads empty and the refresh
# skips its write, and everything else works.
# CH_HOST=127.0.0.1
# CH_PORT_HTTP=8123
# CH_DATABASE=lobbyhub_stats
# CH_USERNAME=default
# CH_PASSWORD=

# Where nginx keeps the answers this API let it keep — the `fastcgi_cache_path`
# from deploy/nginx/conf.d/lobbyhub.conf, and the `levels=` it was declared
# with. Set on a machine with nginx in front of PHP; it is what lets a manual
# refresh drop the stored copy of that server's page read, so a reload right
# after pressing the button is not answered from before the query. Unset, there
# is no shared cache to drop anything from.
# NGINX_CACHE_PATH=/var/cache/nginx/api
# NGINX_CACHE_LEVELS=1:2
