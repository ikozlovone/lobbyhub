APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Telling the frontend that a page it has cached is out of date — the catalog
# growing, a server being published. Without both of these, revalidation is
# skipped and freshness falls back to the cache windows in web/lib/data.ts,
# which are minutes rather than immediate.
# The secret must match REVALIDATE_SECRET in the frontend's environment.
FRONTEND_REVALIDATE_URL=http://localhost:3000/api/revalidate
FRONTEND_REVALIDATE_SECRET=

# Steam Web API key. Used for server discovery, and for "Sign in with Steam":
# the OpenID handshake needs no secret, but the persona name does.
# https://steamcommunity.com/dev/apikey
STEAM_API_KEY=

# Sign-in providers. A provider without credentials is not offered at all —
# the dialog asks the API which buttons to draw. Register the redirect URI as
# {APP_URL}/api/auth/{provider}/callback in each console.
# https://discord.com/developers/applications → OAuth2
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# https://console.cloud.google.com/apis/credentials → OAuth client ID
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email sign-in codes. Defaults: 10 minutes, 5 guesses, 60 seconds between sends.
# AUTH_CODE_TTL=600
# AUTH_CODE_ATTEMPTS=5
# AUTH_CODE_COOLDOWN=60
# AUTH_TOKEN_LIFETIME_DAYS=30
