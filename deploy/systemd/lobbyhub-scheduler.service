# The scheduler. The Linux counterpart of
# deploy/launchd/gg.lobbyhub.scheduler.plist.
#
# `schedule:work` rather than a crontab line: one process, the same behaviour on
# any machine, and the whole timetable stays in routes/console.php instead of
# being split between there and the crontab.

[Unit]
Description=LobbyHub scheduler
After=network.target postgresql.service

[Service]
Type=simple
User=www-data
# Files this process creates — logs, the framework's own caches — come out
# group-writable, so the deploy user that owns the code can rewrite them later.
# It is in the www-data group, but a default umask would leave the group
# read-only and the next deploy would stall on files it cannot replace.
UMask=0002
WorkingDirectory=/var/www/lobbyhub
ExecStart=/usr/bin/php artisan schedule:work
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
