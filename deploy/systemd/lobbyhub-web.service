# The Next.js frontend, which is what nginx proxies to.
#
# Install:
#   sudo cp deploy/systemd/lobbyhub-web.service /etc/systemd/system/
#   sudo systemctl enable --now lobbyhub-web
#
# Bound to loopback: nothing should reach this process except through nginx,
# which is where the Cloudflare check lives.

[Unit]
Description=LobbyHub frontend (Next.js)
After=network.target

[Service]
Type=simple
User=www-data
# Files this process creates — Next's runtime cache under .next — come out
# group-writable, so the deploy user that owns the code can rewrite them later.
# It is in the www-data group, but a default umask would leave the group
# read-only and the next build would stall on files it cannot replace.
UMask=0002
WorkingDirectory=/var/www/lobbyhub/web
Environment=NODE_ENV=production
# NEXT_PUBLIC_* are read at build time, not here; web/.env.local is the file
# that has to be right before `npm run build`. REVALIDATE_SECRET is read at
# runtime, so it does belong to this process.
EnvironmentFile=/var/www/lobbyhub/web/.env.local
# next directly rather than through npm, for two reasons: the hostname can only
# be given as a flag — `next start` defaults to 0.0.0.0 and reads no environment
# variable for it — and npm in between would be a process that forwards systemd's
# signals to the one that matters imperfectly.
ExecStart=/var/www/lobbyhub/web/node_modules/.bin/next start -H 127.0.0.1 -p 3000
# 143 is 128 + SIGTERM, which is the signal systemd itself sends to stop this.
# `next start` installs no handler for it, so Node terminates the default way
# and systemd reads the exit code as a crash: every restart logs "Failed with
# result 'exit-code'" for a stop it asked for. Left alone that is a line in the
# journal that trains you to ignore the ones that mean something, and it counts
# toward the start rate limit that would eventually refuse to bring the service
# back at all.
#
# Only this unit needs it. The two PHP daemons trap the signal and exit 0 —
# measured, not assumed.
SuccessExitStatus=143
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
