# Queue worker for monitoring jobs, one instance per number:
#
#   systemctl enable --now lobbyhub-worker@1 lobbyhub-worker@2
#
# Templated rather than copied, because how many are needed is a property of the
# catalog and not of the code — it grows with the number of servers being polled
# and is best found by watching `php artisan monitoring:status` while adding one
# at a time. See deploy/README.md.
#
# Nothing coordinates them. The queue is a Postgres table and Laravel takes jobs
# with a row lock, so two workers never pick up the same one.
#
# --tries=1 on purpose: a failed query is a legitimate result that the job has
# already recorded as downtime, so retrying it would only distort the history.
# --max-time recycles the process hourly so a leak cannot accumulate.

[Unit]
Description=LobbyHub monitoring queue worker %i
After=network.target postgresql.service

[Service]
Type=simple
User=www-data
# Files this process creates — logs, the framework's own caches — come out
# group-writable, so the deploy user that owns the code can rewrite them later.
# It is in the www-data group, but a default umask would leave the group
# read-only and the next deploy would stall on files it cannot replace.
UMask=0002
WorkingDirectory=/var/www/lobbyhub
# Two queues, in priority order, and the order is the whole point. Laravel takes
# the leftmost queue that has anything in it, so a Steam sweep always goes ahead
# of the per-server queries however many of those are waiting.
#
# Sharing one queue took the monitor down. The dispatcher can add two thousand
# queries a minute, the database driver hands jobs out in id order, and a sweep
# queued behind a hundred thousand of them was thirty hours from running. With
# no sweeps nothing refreshed the servers' coverage, so all of them fell to the
# poller and made the queue longer — with the catalog at 127 000 that settled at
# 1% of the intended cadence.
ExecStart=/usr/bin/php artisan queue:work --queue=steam,monitoring --tries=1 --sleep=1 --max-time=3600
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
