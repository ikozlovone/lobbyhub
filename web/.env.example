# Laravel catalog API
NEXT_PUBLIC_API_URL=http://localhost:8000/api
# Public origin of this frontend, used for canonicals and the sitemap
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Where takedown and account-deletion requests go. Shown on /terms, so an unset
# one puts "hello@example.com" on a page that promises somebody an answer.
NEXT_PUBLIC_CONTACT_EMAIL=hello@example.com

# Where server-side renders and the production build reach the API. Optional: set
# it when the API runs on the same machine, so neither has to leave the box — and
# so a build does not depend on the site already being reachable from outside.
# The nginx config listens for this on 127.0.0.1:8080.
# API_URL_INTERNAL=http://127.0.0.1:8080/api
