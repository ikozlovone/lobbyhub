# Laravel catalog API
NEXT_PUBLIC_API_URL=http://localhost:8000/api
# Public origin of this frontend, used for canonicals and the sitemap
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Who is legally answerable for the site -----------------------------------
# All four appear on /terms and /privacy, and GDPR Art. 13 makes the first three
# mandatory: a privacy notice that names nobody is not a notice. Leave any unset
# and both pages carry a visible "this deployment is not configured" warning
# rather than quietly promising somebody an answer that never arrives.

# A person's full name, or the registered name of the company.
NEXT_PUBLIC_CONTROLLER_NAME=
# A postal address somebody can write to. An email address alone does not satisfy
# "contact details".
NEXT_PUBLIC_CONTROLLER_ADDRESS=
# Where takedown, access and deletion requests go.
NEXT_PUBLIC_CONTACT_EMAIL=
# The country the server physically sits in. It decides whether the privacy
# notice has an international transfer to disclose.
NEXT_PUBLIC_HOSTING_COUNTRY=

# --- Consent -------------------------------------------------------------------
# Which non-essential purposes this deployment actually runs something for:
# any of "analytics", "advertising", comma separated. Empty means there is
# nothing to ask about and no banner is shown — which is the truth today, since
# the site loads no analytics and no ad script.
#
# Set this the same day the tag goes in, not after: under the ePrivacy Directive
# the consent has to come BEFORE the storage, and an ad script shipped while this
# is empty is a script running without anyone's permission.
NEXT_PUBLIC_CONSENT_CATEGORIES=

# Google Analytics 4 measurement ID (G-XXXXXXXXXX). Loaded only when the visitor
# has allowed the `analytics` category above — so both variables have to be set
# for anything to actually track. Empty here means the tag never mounts, which
# is the deliberate default: no ID, no request to Google.
NEXT_PUBLIC_GA_ID=

# Where server-side renders and the production build reach the API. Optional: set
# it when the API runs on the same machine, so neither has to leave the box — and
# so a build does not depend on the site already being reachable from outside.
# The nginx config listens for this on 127.0.0.1:8080.
# API_URL_INTERNAL=http://127.0.0.1:8080/api